/*
 * SD card over HARDWARE SPI (SPIM22) for Seeed XIAO nRF54L15 (Sense).
 *
 * NEW wiring (moved off P2 so a real hardware SPI master can drive it):
 *   SCK  = P1.05  (XIAO D1)
 *   MOSI = P1.06  (XIAO D2)
 *   MISO = P1.07  (XIAO D3)
 *   CS   = P1.04  (XIAO D0)   <- unchanged
 *
 * Why SPIM22 on P1:
 *   On nRF54L15 the PERI-domain SPIM instances (20/21/22) are native to GPIO
 *   port P1 and work as full SPI masters there. (They cannot drive P2 as SPI
 *   masters -- P2 from the PERI domain is only for SPIS/UARTE.) SPIM22 shares
 *   its hardware block only with I2C22 (external I2C, unused here; the IMU is on
 *   I2C30), so the console on UART20 -> USB (COM port) stays fully intact.
 */

&pinctrl {
	spi22_sd_default: spi22_sd_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,    /* D1  P1.05 */
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,   /* D2  P1.06 */
				<NRF_PSEL(SPIM_MISO, 1, 7)>;   /* D3  P1.07 */
		};
	};

	spi22_sd_sleep: spi22_sd_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,
				<NRF_PSEL(SPIM_MISO, 1, 7)>;
			low-power-enable;
		};
	};
};

/* Free serial-22 from its default I2C role so it can be an SPI master. */
&i2c22 {
	status = "disabled";
};

/* Default board hardware SPI (SPIM00 on P2) is unused now. */
&xiao_spi {
	status = "disabled";
};

&spi22 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi22_sd_default>;
	pinctrl-1 = <&spi22_sd_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	cs-gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;   /* D0 P1.04 */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/ {
	aliases {
		sdhc0 = &sdhc0;
	};
};
