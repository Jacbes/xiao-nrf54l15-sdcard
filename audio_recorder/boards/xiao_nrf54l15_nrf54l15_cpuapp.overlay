/*
 * SD card on HARDWARE SPI (SPIM22) + PDM microphone + button + LED
 * for Seeed XIAO nRF54L15.
 *
 * Wiring:
 *   SD card:
 *     SCK  = P1.05 (D1)
 *     MOSI = P1.06 (D2)
 *     MISO = P1.07 (D3)
 *     CS   = P1.04 (D0)
 *   PDM mic:
 *     CLK  = P1.12
 *     DAT  = P1.13
 *   Button = P0.00
 *   LED    = P2.00
 */

&pinctrl {
	spi22_sd_default: spi22_sd_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,    /* D1  P1.05 */
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,   /* D2  P1.06 */
				<NRF_PSEL(SPIM_MISO, 1, 7)>;   /* D3  P1.07 */
		};
	};

	spi22_sd_sleep: spi22_sd_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,
				<NRF_PSEL(SPIM_MISO, 1, 7)>;
			low-power-enable;
		};
	};
};

/* Free serial-22 from its default I2C role so it can be an SPI master. */
&i2c22 {
	status = "disabled";
};

/* Default board hardware SPI (SPIM00 on P2) is unused now. */
&xiao_spi {
	status = "disabled";
};

&spi22 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi22_sd_default>;
	pinctrl-1 = <&spi22_sd_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	cs-gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;   /* D0 P1.04 */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		/* 4 MHz: more timing margin for marginal cards/wiring than 8 MHz,
		 * still far faster than the ~64 KiB/s audio needs. */
		spi-max-frequency = <4000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* Enable the hardware watchdog (WDT31) so a hung thread reboots the SoC. */
&wdt31 {
	status = "okay";
};

/* PDM microphone on P1.12 (CLK) / P1.13 (DIN) - default board pins.
 * queue-size kept small (6): our own 64 KiB ring buffer absorbs SD
 * latency, and a small driver queue avoids mem-slab exhaustion that would
 * otherwise stop the PDM peripheral. */
&pdm20 {
	status = "okay";
	pinctrl-0 = <&pdm20_default>;
	pinctrl-names = "default";
	clock-source = "PCLK32M";
	queue-size = <6>;
};

/ {
	aliases {
		sdhc0 = &sdhc0;
	};
};
